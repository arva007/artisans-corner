# ===============================================
# Artisan's Corner - Backend Environment Configuration
# ===============================================

# Server Environment
PORT=5000
NODE_ENV=production

# Client Application URL(s) - Comma-separated for multiple origins
CLIENT_URL=https://your-artisan-corner-app.vercel.app

# Database Configuration (MongoDB Atlas Connection URI)
# Supports both MONGO_URI (standard for Render / Atlas) and MONGODB_URI
# Format: mongodb+srv://<username>:<password>@<cluster-address>/artisan_corner?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/artisan_corner?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/artisan_corner?retryWrites=true&w=majority

# JWT Authentication
# Generate strong key via: openssl rand -base64 64
JWT_SECRET=your_production_64_character_hex_or_base64_jwt_secret_key
JWT_EXPIRE=30d

# Platform Monetization (5% platform fee)
PLATFORM_COMMISSION_PERCENT=5

# Stripe Live/Test Payment Processing
# Secret key from Stripe Dashboard -> Developers -> API Keys
STRIPE_SECRET_KEY=sk_live_your_actual_stripe_secret_key

# Stripe Webhook Signing Secret (Stripe Dashboard -> Developers -> Webhooks)
# Used to verify signatures on /api/payments/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_actual_stripe_webhook_secret

# Cloudinary Image Hosting Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
