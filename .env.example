# ===============================================
# Artisan's Corner - Environment Variables Example
# Copy this file to server/.env and adjust values
# ===============================================

# Server Environment
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (MongoDB connection URI)
# Supports both MONGO_URI (recommended on Render/Atlas) and MONGODB_URI
# If local mongod is not running, the server automatically starts an embedded in-memory MongoDB for development!
# MONGO_URI=mongodb+srv://<db_user>:<db_password>@cluster0.example.mongodb.net/artisan_corner?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/artisan_corner

# JWT Authentication
JWT_SECRET=artisan_corner_super_secret_jwt_key_2026_change_in_production
JWT_EXPIRE=30d

# Platform Fee
PLATFORM_COMMISSION_PERCENT=5

# Stripe Configuration (Test Mode Keys)
# Leave placeholder or empty to enable graceful test payment simulation
STRIPE_SECRET_KEY=sk_test_placeholder_key_for_development
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# Cloudinary Configuration
# Leave placeholder or empty to enable mock/data-url fallback uploads
CLOUDINARY_CLOUD_NAME=demo_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=placeholder_secret
