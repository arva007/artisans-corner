# ===============================================
# Artisan's Corner - Frontend Environment Configuration
# ===============================================

# Backend API Root Endpoint:
# Local Development: /api (proxied by Vite dev server to localhost:5000)
# Production Deployment (Vercel/Netlify/Render Static): https://your-artisan-backend.onrender.com/api
VITE_API_URL=/api

# Stripe Publishable Key (From Stripe Dashboard -> Developers -> API Keys)
# Live key starts with pk_live_... or pk_test_... in sandbox
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_actual_stripe_publishable_key
